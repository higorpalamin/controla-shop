generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  role      Role     @default(FUNCIONARIO)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Produto {
  id            String         @id @default(cuid())
  nome          String
  sku           String?        @unique
  codigoBarras  String?        @unique
  descricao     String?
  precoCompra   Decimal
  precoVenda    Decimal
  estoqueMinimo Int
  quantidade    Int
  categoriaId   String
  fornecedorId  String
  createdAt     DateTime       @default(now())
  movimentacoes Movimentacao[]
  categoria     Categoria      @relation(fields: [categoriaId], references: [id])
  fornecedor    Fornecedor     @relation(fields: [fornecedorId], references: [id])
}

model Categoria {
  id       String    @id @default(cuid())
  nome     String
  produtos Produto[]
}

model Fornecedor {
  id       String    @id @default(cuid())
  nome     String
  telefone String?
  email    String?   @unique
  cnpj     String?   @unique
  bairro   String?
  cep      String?
  cidade   String?
  estado   String?
  ie       String?   @unique
  rua      String?
  produtos Produto[]
}

model Movimentacao {
  id         String           @id @default(cuid())
  produtoId  String
  tipo       TipoMovimentacao
  quantidade Int
  observacao String?
  createdAt  DateTime         @default(now())
  produto    Produto          @relation(fields: [produtoId], references: [id])
}

enum Role {
  ADMIN
  FUNCIONARIO
}

enum TipoMovimentacao {
  ENTRADA
  SAIDA
}
